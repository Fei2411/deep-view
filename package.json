{
  "name": "deep-view",
  "version": "0.1.1",
  "description": "Deep View: interactive views (charts, tables, inputs, answers) in any DeepSeek Harness chat",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "deepseek",
    "widgets",
    "ui"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./core": "./src/core/index.js",
    "./react": "./src/react/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src/core/",
    "src/react/",
    "src/host/",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --import ./test/harness-resolve.mjs --test \"test/*.test.js\"",
    "lint": "node scripts/lint.mjs",
    "harness": "npm install --prefix dev/harness --legacy-peer-deps=false --no-package-lock --no-fund --no-audit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-web": "*"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "homepage": "https://github.com/Fei2411/deep-view#readme",
  "bugs": {
    "url": "https://github.com/Fei2411/deep-view/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fei2411/deep-view.git"
  }
}
